[global]
    font = Adwaita Sans 10
    markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no

    width = 300
    origin = top-right
    offset = 30x20
    notification_limit = 5
    shrink = no
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse

    sticky_history = yes
    history_length = 20
    show_indicators = yes
    line_height = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab

    icon_position = left
    max_icon_size = 8
    min_icon_size = 8
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    frame_width = 2
    frame_color = "#7fbbb3"
    corner_radius = 4

[urgency_low]
    background = "#2d353b"
    foreground = "#d3c6aa"
    highlight = "#a7c080"
    timeout = 10

[urgency_normal]
    background = "#2d353b"
    foreground = "#d3c6aa"
    highlight = "#a7c080"
    timeout = 10

[urgency_critical]
    background = "#2d353b"
    foreground = "#e67e80"
    frame_color = "#e67e80"
    timeout = 0
